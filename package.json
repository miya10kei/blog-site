{
	"name": "tech-blog",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"prepare": "husky"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.1.0",
		"fuse.js": "^7.5.0",
		"lucide-react": "^1.73.0",
		"next": "16.4.6",
		"next-mdx-remote-client": "^2.1.12",
		"next-themes": "^0.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@playwright/test": "^1.65.1",
		"@sentry/nextjs": "^11.13.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.12",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"lint-staged": "^17.6.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"biome check --write"
		],
		"*.{json,md}": [
			"biome format --write"
		]
	}
}
